{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StepTrace",
  "type": "object",
  "required": ["traceId", "topicId", "steps"],
  "properties": {
    "traceId": { "type": "string" },
    "topicId": { "type": "string" },
    "version": { "type": "string" },
    "targetConsole": { "type": "string", "enum": ["gcp", "aws", "azure", "salesforce", "servicenow"] },
    "viewport": {
      "type": "object",
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "deviceScaleFactor": { "type": "number" }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "index", "act", "intent", "action"],
        "properties": {
          "id": { "type": "string" },
          "index": { "type": "integer" },
          "act": { "type": "string" },
          "intent": { "type": "string" },
          "action": {
            "type": "string",
            "enum": ["navigate", "click", "type", "hover", "select", "wait_condition", "clear_input", "press_key"]
          },
          "targetUrl": { "type": "string" },
          "selector": {
            "type": "object",
            "required": ["primary"],
            "properties": {
              "primary": {
                "type": "object",
                "required": ["role", "name"],
                "properties": {
                  "role": { "type": "string" },
                  "name": { "type": "string" },
                  "exact": { "type": "boolean" }
                }
              },
              "secondary": {
                "type": "object",
                "properties": {
                  "testId": { "type": "string" }
                }
              },
              "fallback": {
                "type": "object",
                "properties": {
                  "bbox": {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 4,
                    "maxItems": 4
                  }
                }
              }
            }
          },
          "textValue": { "type": "string" },
          "key": { "type": "string" },
          "conditionGate": { "type": "object" },
          "dwellTimeMs": { "type": "number" },
          "redactPii": { "type": "boolean" },
          "cameraFocus": { "type": "boolean" }
        }
      }
    }
  }
}
